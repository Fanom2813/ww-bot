<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="ww-bot"
        Arguments=""
        InstallLocation="C:\Program Files\ww-bot\WW Bot">
    </Installer>
    <PackageInformation
        PackageName="WW Bot"
        PackageDisplayName="WW Bot"
        PublisherName="CN=ww-bot"
        PublisherDisplayName="ww-bot"
        Version="0.1.0.0"
        PackageDescription="WhatsApp AI reply assistant">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.wwbot.app"
                Description="WhatsApp AI reply assistant"
                DisplayName="WW Bot"
                ExecutableName="ww-bot"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>WW Bot</DisplayName>
            <PublisherDisplayName>ww-bot</PublisherDisplayName>
            <Description>WhatsApp AI reply assistant</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="ww-bot.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
